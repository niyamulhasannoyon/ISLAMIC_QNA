{
  "name": "fatwa-search-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.5.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "type-check": "turbo run type-check",
    "sync:live": "python3 scraper/incremental_scraper.py",
    "eval:search": "tsx scripts/eval-search.ts",
    "search:weekly-loop": "tsx scripts/search-quality-weekly-loop.ts",
    "generate:embeddings": "tsx scripts/generate-embeddings.ts",
    "web:dev": "npm run dev --workspace=@repo/web",
    "web:build": "npm run build --workspace=@repo/web",
    "web:test": "npm run test --workspace=@repo/web",
    "mobile:dev": "npm run dev --workspace=@repo/mobile"
  },
  "devDependencies": {
    "@xenova/transformers": "^2.17.2",
    "prettier": "^3.3.3",
    "tsx": "^4.23.13",
    "turbo": "^2.11.13",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20.0.0 <23.0.0"
  }
}
