# Secret token for protecting the ingestion endpoint (/api/v1/ingest)
INGESTION_SECRET_TOKEN=super_secure_fatwa_ingest_token_change_me_in_prod

# Cryptographic secret key for session signing and auth (REQUIRED, min 32 characters)
AUTH_SECRET=your_32_plus_character_secure_random_auth_secret_key_here

# Allowed Admin Emails (comma-separated, case-insensitive)
ADMIN_EMAILS=niyamulhasanbd@gmail.com,niyamulhasan1089@gmail.com

# Base URL for API calls
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Search Engine Provider ('local' | 'meilisearch' | 'mongodb')
SEARCH_ENGINE=local

# SQLite Database Path (Optional: defaults to ./data/fatwas.db locally, /tmp/fatwas.db on Vercel)
# DATABASE_PATH=./data/fatwas.db

# Optional Cloud Search Engine Configs:
# MEILISEARCH_HOST=https://your-meilisearch-host.com
# MEILISEARCH_API_KEY=your-meilisearch-key
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/fatwa_archive

# MongoDB Atlas Vector Search & Embedding Configuration
# OPENAI_API_KEY=your_openai_api_key_here
# VECTOR_INDEX_NAME=vector_index
# GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=mixtral-8x7b-32768

# Optional AI API Key for On-Demand Summary & RAG (Mistral AI)
MISTRAL_API_KEY=your-mistral-api-key

# Google OAuth Credentials for Sign in with Google
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# Optional Admin Credentials (If not set, username/password admin login is completely disabled)
# ADMIN_USERNAME=your_admin_username
# ADMIN_PASSWORD=your_secure_admin_password

