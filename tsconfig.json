{
  "extends": "./packages/config/tsconfig/base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./apps/web/src/*", "./src/*"],
      "@repo/config/*": ["./packages/config/*"],
      "@repo/text-utils": ["./packages/text-utils/src/index.ts"],
      "@repo/text-utils/*": ["./packages/text-utils/src/*"],
      "@repo/api-client": ["./packages/api-client/src/index.ts"],
      "@repo/api-client/*": ["./packages/api-client/src/*"]
    }
  },
  "include": [
    "scripts/**/*"
  ],
  "exclude": [
    "node_modules",
    "apps",
    "packages"
  ]
}
